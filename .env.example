# ========================================================
# TEMPLATE ENVIRONMENT VARIABLES - TAMANBACA WARGA
# Catatan Keamanan: Jangan pernah mengunggah file .env asli dengan
# secret yang nyata ke version control (Git).
# ========================================================

# Koneksi Database PostgreSQL (misal Neon / Supabase)
# DATABASE_URL: Menggunakan connection pooler (port 6543 atau direct Neon pooling)
# DIRECT_URL: Koneksi langsung tanpa pooler untuk sinkronisasi skema Prisma (db push / CLI)
DATABASE_URL="postgresql://username:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Password Akun Demo untuk Seed Script (Wajib kuat: min. 10 karakter, kombinasi huruf & angka)
SEED_ADMIN_EMAIL="admin@tamanbaca.id"
SEED_ADMIN_PASSWORD="<masukkan-password-admin-kuat-min-10-karakter>"

SEED_MEMBER_EMAIL="warga@tamanbaca.id"
SEED_MEMBER_PASSWORD="<masukkan-password-member-kuat-min-10-karakter>"

# Besaran denda keterlambatan per hari (dalam Rupiah)
FINE_PER_DAY=1000

# URL Dasar Aplikasi (digunakan untuk validasi header Origin proteksi CSRF)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Lingkungan: development | production
NODE_ENV="development"
